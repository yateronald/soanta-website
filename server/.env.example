# Copy to .env and fill in. On Render, set these in the service's Environment tab.

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
# Optional: CA certificate (PEM) to verify the database's TLS certificate
# DB_CA_CERT=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Default admin account (created/updated at startup)
ADMIN_EMAIL=exportinfos@soanta.com
ADMIN_PASSWORD=

# Server
PORT=3002
FRONTEND_URL=http://localhost:5173
